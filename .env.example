# Скопировать в .env и поправить:  cp .env.example .env
# .env в гит не попадает (см. .gitignore)

# Порт, на котором стенд доступен на хосте
SUPERSET_HTTP_PORT=8081

# Имя контейнера (его же используют scripts/*.sh) — чтобы две версии Superset
# могли работать рядом, не перекрывая друг друга
SUPERSET_CONTAINER=superset_latest
SUPERSET_IMAGE=superset-latest-app

# Секрет для подписи сессий (обязателен; сгенерировать: openssl rand -hex 32)
SUPERSET_SECRET_KEY=change-me-openssl-rand-hex-32

# Первый администратор: создаётся автоматически при первом запуске
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@localhost
ADMIN_FIRSTNAME=Superset
ADMIN_LASTNAME=Admin

# Метаданные. Пусто = SQLite в ./superset_home/superset.db.
# Для PostgreSQL раскомментировать строку ниже и сервис meta-db в docker-compose.yml.
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://superset:superset@meta-db:5432/superset
SQLALCHEMY_DATABASE_URI=
